# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Port the API server listens on.
PORT=3000

# Secret used to sign login tokens (JWT). Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Optional: when it is left out, a secret is generated once and kept in the
# data folder (.jwt-secret), so logins survive restarts and new copies.
# JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Google OAuth credentials (from Google Cloud Console, YouTube Data API v3 enabled).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
REDIRECT_URI=http://localhost:3000/auth/google/callback

# SoundCloud OAuth 2.1 credentials (https://developers.soundcloud.com/docs/api/register-app;
# an Artist Pro account is required to register an app). Register the redirect
# URI below on the app. Leave blank to run SoundCloud search and playback
# through yt-dlp instead (no account connect / library in that mode).
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=http://localhost:3000/auth/soundcloud/callback
# auto (default): official API when credentials exist, else yt-dlp; API errors
# such as rate limits fall back to yt-dlp. `api` or `ytdlp` forces one.
SOUNDCLOUD_PROVIDER=auto

# Run `yt-dlp -U` in the background shortly after the server starts, at most
# once a day (default true).
YTDLP_AUTO_UPDATE=true

# Where the browser/webview is served from. Comma-separated for multiple origins.
CLIENT_ORIGIN=http://localhost:5173

# Interface the API binds to. Loopback by default so the desktop app's API is
# not reachable from the local network. Use 0.0.0.0 only inside a container.
HOST=127.0.0.1

# Key for encrypting stored OAuth tokens (32 bytes: 64 hex chars or base64).
# Leave blank to have the server generate `.token-key` (owner-only) on first
# run. The desktop build should supply this from the OS keychain. Changing it
# makes stored connections unreadable: users simply reconnect.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
TOKEN_ENCRYPTION_KEY=

# Audio cache size cap in bytes (default 524288000 = 500 MB). Least recently
# played tracks are evicted first.
CACHE_MAX_BYTES=524288000

# Match engine: Spotify (and other match-mode sources) plays through a YouTube
# video matched by services/matcher; see README "Matching engine". All optional,
# defaults shown.
# Largest |track duration - candidate duration| in seconds for a match to count.
MATCH_DURATION_TOLERANCE_SEC=5
# Concurrent YouTube Music searches (the yt-dlp fallback always runs one at a time).
MATCH_CONCURRENCY=4
# How long a library or resolve request waits for matches before reporting the rest as pending.
MATCH_REQUEST_BUDGET_MS=25000
# How long a not_found result is trusted before the track is searched again (30 days).
MATCH_NOT_FOUND_TTL_MS=2592000000
# How long a failed search is remembered before it is retried (10 minutes).
MATCH_ERROR_TTL_MS=600000
# on (default): run yt-dlp ytsearch when the YouTube Music search fails; off disables it.
MATCH_YTDLP_FALLBACK=on
# true: also run yt-dlp when YouTube Music found no acceptable candidate (slow, ~10 s per query).
MATCH_YTDLP_RECALL=false

# Audius (search and playback need no account). Optional: a free API key from
# https://api.audius.co/plans for higher rate limits; AUDIUS_API_BASE is only
# for testing against another host.
AUDIUS_API_KEY=
# AUDIUS_API_BASE=https://api.audius.co/v1

# Cloud sync (docs/cloud-data.md): the address of your own cloud service
# (cloud/README.md). Normally entered in the app (Settings, Accounts); set it
# here to fix it for everyone on this installation.
# CLOUD_URL=https://music-manager-cloud.your-name.workers.dev

# The server keeps its log in logs/server.log in the data folder (the project
# folder when run from source). off: print to the terminal only.
# LOG_FILE=off

# Lyrics: for music that is not your own files, lyrics are looked up on LRCLIB
# (https://lrclib.net) once the user agrees in the app; a lookup sends the
# track's title, artist and length. off: never look lyrics up online.
# LRCLIB_URL points at another LRCLIB instance (it can be self-hosted).
# LYRICS_ONLINE=off
# LRCLIB_URL=https://lrclib.net

# Local files: music folders must be inside your home folder or on another
# drive / mounted volume (/Volumes on macOS; /media, /mnt, /run/media on
# Linux; any drive letter but the system drive on Windows). To allow other
# locations (network shares included), list them here, separated by ":"
# (";" on Windows).
# LOCAL_MUSIC_ROOTS=/srv/music:/opt/audio
