# Copy this file to `.env` and fill in real values. NEVER commit `.env`.

# Port the API server listens on.
PORT=3000

# Secret used to sign login tokens (JWT). Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string-at-least-32-chars

# Google OAuth credentials (from Google Cloud Console, YouTube Data API v3 enabled).
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
REDIRECT_URI=http://localhost:3000/auth/google/callback

# SoundCloud OAuth 2.1 credentials (https://developers.soundcloud.com/docs/api/register-app;
# an Artist Pro account is required to register an app). Register the redirect
# URI below on the app. Leave blank to run SoundCloud search and playback
# through yt-dlp instead (no account connect / library in that mode).
SOUNDCLOUD_CLIENT_ID=
SOUNDCLOUD_CLIENT_SECRET=
SOUNDCLOUD_REDIRECT_URI=http://localhost:3000/auth/soundcloud/callback
# auto (default): official API when credentials exist, else yt-dlp; API errors
# such as rate limits fall back to yt-dlp. `api` or `ytdlp` forces one.
SOUNDCLOUD_PROVIDER=auto

# Run `yt-dlp -U` in the background each time the server starts (default true).
YTDLP_AUTO_UPDATE=true

# Where the browser/webview is served from. Comma-separated for multiple origins.
CLIENT_ORIGIN=http://localhost:5173

# Match engine: Spotify (and other match-mode sources) plays through a YouTube
# video matched by services/matcher; see README "Matching engine". All optional,
# defaults shown.
# Largest |track duration - candidate duration| in seconds for a match to count.
MATCH_DURATION_TOLERANCE_SEC=5
# Concurrent YouTube Music searches (the yt-dlp fallback always runs one at a time).
MATCH_CONCURRENCY=4
# How long a library or resolve request waits for matches before reporting the rest as pending.
MATCH_REQUEST_BUDGET_MS=25000
# How long a not_found result is trusted before the track is searched again (30 days).
MATCH_NOT_FOUND_TTL_MS=2592000000
# How long a failed search is remembered before it is retried (10 minutes).
MATCH_ERROR_TTL_MS=600000
# on (default): run yt-dlp ytsearch when the YouTube Music search fails; off disables it.
MATCH_YTDLP_FALLBACK=on
# true: also run yt-dlp when YouTube Music found no acceptable candidate (slow, ~10 s per query).
MATCH_YTDLP_RECALL=false
