// Cloudflare Worker + D1 for Music Manager's cloud sync (docs/cloud-data.md).
// Deploy steps are in cloud/README.md.
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "music-manager-cloud",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  "d1_databases": [
    {
      "binding": "DB",
      // The owner's database. Neither value is a secret. Someone running
      // their own copy replaces both with what `npx wrangler d1 create` prints
      // (or what the D1 page in the Cloudflare dashboard shows).
      "database_name": "music-manager-db",
      "database_id": "62150c2f-ce3d-4db1-8d1a-be8ad4a94036",
      "migrations_dir": "migrations"
    }
  ]
  // Secrets are never written here. They are set with `npx wrangler secret put <NAME>`:
  //   JWT_SECRET         signs the session tokens (required)
  //   REGISTRATION_CODE  whoever knows it may create an account; unset = sign-up closed
  //   AUTH_PEPPER        optional extra secret mixed into stored login hashes
}
