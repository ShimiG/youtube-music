{
  "name": "music-manager",
  "version": "1.0.0",
  "description": "Hybrid React, Node, and Tauri Music Player",
  "main": "server.js",
  "bin": "server.js",
  "author": "Shimi G",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "lint": "eslint .",
    "build:server:win": "pkg ./server.js --target node18-win-x64 --output ./bin/music-server-x86_64-pc-windows-msvc.exe",
    "build:server:mac": "pkg ./server.js --target node18-macos-arm64 --output ./bin/music-server-aarch64-apple-darwin",
    "build:all": "npm run build:server:win && npm run build:server:mac && cd client && npm run build",
    "tauri:build": "npm run build:all && tauri build",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "prepare": "husky"
  },
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "ffmpeg-static": "^5.3.0",
    "googleapis": "^170.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "sqlite": "^5.1.1",
    "sqlite3": "^5.1.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tauri-apps/cli": "^1.6.3",
    "auto-changelog": "^2.5.0",
    "concurrently": "^9.2.1",
    "eslint": "^9.15.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "pkg": "^5.8.1",
    "supertest": "^7.2.2"
  },
  "pkg": {
    "assets": [
      "public/**/*",
      "bin/**/*"
    ]
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ]
  }
}
