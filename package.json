{
  "name": "music-manager",
  "version": "1.0.0",
  "description": "Hybrid React, Node, and Tauri Music Player",
  "main": "server.js",
  "author": "Shimi G",
  "license": "MIT",
  "scripts": {
    "start": "node server.js",
    "server": "node server.js",
    "client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run server\" \"npm run client\"",
    "lint": "eslint .",
    "build:server": "node scripts/build-sea.mjs",
    "build:all": "npm run build:server && npm run build --prefix client",
    "tauri:build": "npm run build:all && tauri build",
    "test": "jest",
    "test:watch": "jest --watchAll",
    "prepare": "husky"
  },
  "dependencies": {
    "@googleapis/youtube": "^40.0.2",
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "ffmpeg-static": "^5.3.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "@tauri-apps/cli": "^2.12.4",
    "auto-changelog": "^2.5.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^9.15.0",
    "husky": "^9.1.7",
    "jest": "^30.2.0",
    "postject": "^1.0.0-alpha.6",
    "supertest": "^7.2.2"
  },
  "overrides": {
    "tar": ">=7.5.21",
    "shell-quote": ">=1.9.0",
    "ip-address": ">=10.3.1",
    "qs": ">=6.16.0",
    "brace-expansion": ">=2.1.4",
    "minimatch": ">=3.1.3",
    "js-yaml": ">=4.3.2",
    "flatted": ">=3.4.2",
    "browserslist": ">=4.28.7",
    "baseline-browser-mapping": ">=2.11.0"
  },
  "jest": {
    "testEnvironment": "node",
    "setupFiles": [
      "<rootDir>/tests/setup.js"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "<rootDir>/.claude/",
      "<rootDir>/client/"
    ]
  },
  "engines": {
    "node": ">=22.13"
  }
}
