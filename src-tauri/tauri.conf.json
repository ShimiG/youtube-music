{
  "$schema": "../node_modules/@tauri-apps/cli/schema.json",
  "build": {
    "beforeBuildCommand": "",
    "beforeDevCommand": "npm run dev",
    "devPath": "http://localhost:5173",
    "distDir": "../client/dist"
  },
  "package": {
    "productName": "Music Manager",
    "version": "0.1.0"
  },
"tauri": {
    "bundle": {
      "identifier": "com.musicmanager.app",
      "externalBin": [
        "../bin/music-server"
      ]
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": true
    },
    "allowlist": {
      "shell": {
        "sidecar": true,
        "execute": true,
        "open":true
      }
    },
    "security": {
      "csp": null
    },
    "windows": [
      {
        "title": "Music Manager",
        "width": 1200,
        "height": 800
      }
    ]
  }
}
